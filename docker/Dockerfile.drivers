# Start from ROS 2 Humble base image
FROM ros:humble

# Install only required runtime dependencies (Removed micro-ros-agent due to ARM64 limits)
RUN apt-get update && apt-get install -y \
    ros-humble-realsense2-camera \
    ros-humble-cv-bridge \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-can-msgs \
    can-utils \
    git \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Build micro-ROS agent from source for ARM64 Jetson
WORKDIR /microros_ws
RUN git clone -b humble https://github.com/micro-ROS/micro_ros_setup.git src/micro_ros_setup && \
    . /opt/ros/humble/setup.sh && \
    apt-get update && rosdep update && rosdep install --from-paths src --ignore-src -y && \
    colcon build && \
    . install/local_setup.sh && \
    ros2 run micro_ros_setup create_agent_ws.sh && \
    ros2 run micro_ros_setup build_agent.sh && \
    rm -rf /var/lib/apt/lists/*

# ROS environment
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV ROS_DOMAIN_ID=42

WORKDIR /bfmc_ws
