<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>free_space_cpp</name>
  <version>3.0.0</version>
  <description>
    Depth-only free space occupancy grid node for BFMC PR3.
    Classical CV pipeline. No ML. Deterministic, lifecycle-managed.
    Production freeze v3 -- stride-safe, watchdog, single-threaded.
  </description>
  <maintainer email="sambankar0303@gmail.com">Team OdyssiX</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>bfmc_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
