<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drift_estimator</name>
  <version>1.0.0</version>
  <description>Lifecycle node for low-frequency yaw drift estimation and EKF bias correction.</description>
  <maintainer email="sambankar0303@gmail.com">Team OdyssiX</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_msgs</depend>
  <depend>bfmc_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
